{
    "dashboard": {
        "title": "INDB Performance Dashboard",
        "tags": [
            "indb",
            "performance"
        ],
        "timezone": "browser",
        "panels": [
            {
                "title": "Event Ingestion Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(indb_events_total[5m])",
                        "legendFormat": "{{node}}"
                    }
                ]
            },
            {
                "title": "Query Latency (P95)",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(indb_query_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{node}}"
                    }
                ]
            },
            {
                "title": "Cache Hit Rate",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(indb_cache_hits_total[5m]) / (rate(indb_cache_hits_total[5m]) + rate(indb_cache_misses_total[5m]))",
                        "legendFormat": "{{cache_type}}"
                    }
                ]
            },
            {
                "title": "Memory Usage",
                "type": "graph",
                "targets": [
                    {
                        "expr": "process_resident_memory_bytes{job=\"indb\"}",
                        "legendFormat": "{{node}}"
                    }
                ]
            },
            {
                "title": "CPU Usage",
                "type": "graph",
                "targets": [
                    {
                        "expr": "rate(process_cpu_seconds_total{job=\"indb\"}[5m])",
                        "legendFormat": "{{node}}"
                    }
                ]
            },
            {
                "title": "Raft Leader Status",
                "type": "stat",
                "targets": [
                    {
                        "expr": "indb_raft_is_leader",
                        "legendFormat": "{{node}}"
                    }
                ]
            }
        ]
    }
}